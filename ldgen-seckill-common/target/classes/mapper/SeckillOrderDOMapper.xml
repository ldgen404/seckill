<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ldgen.seckill.common.domain.mapper.SeckillOrderDOMapper">

    <resultMap id="BaseResultMap" type="com.ldgen.seckill.common.domain.dataobject.SeckillOrderDO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="activityId" column="activity_id"/>
        <result property="goodsId" column="goods_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="seckillPrice" column="seckill_price"/>
        <result property="goodsName" column="goods_name"/>
        <result property="goodsImg" column="goods_img"/>
        <result property="status" column="status"/>
        <result property="expireTime" column="expire_time"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,user_id,activity_id,goods_id,order_no,seckill_price,
        goods_name,goods_img,status,expire_time,is_deleted,
        create_time,update_time
    </sql>

    <!-- 插入订单，并回填自增主键 -->
    <insert id="insert" parameterType="com.ldgen.seckill.common.domain.dataobject.SeckillOrderDO" useGeneratedKeys="true" keyProperty="id">
        insert into t_seckill_order (user_id, activity_id,
                                     goods_id, order_no, seckill_price,
                                     goods_name, goods_img, `status`,
                                     expire_time, is_deleted, create_time,
                                     update_time)
        values (#{userId,jdbcType=BIGINT}, #{activityId,jdbcType=BIGINT},
                #{goodsId,jdbcType=BIGINT}, #{orderNo,jdbcType=VARCHAR}, #{seckillPrice,jdbcType=DECIMAL},
                #{goodsName,jdbcType=VARCHAR}, #{goodsImg,jdbcType=VARCHAR}, #{status,jdbcType=TINYINT},
                #{expireTime,jdbcType=TIMESTAMP}, #{isDeleted,jdbcType=TINYINT}, #{createTime,jdbcType=TIMESTAMP},
                #{updateTime,jdbcType=TIMESTAMP})
    </insert>

</mapper>
